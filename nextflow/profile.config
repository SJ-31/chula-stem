params {
    config_profile_description = 'CuAIM cluster profile'
    config_profile_contact = 'Shann Chongwattananukul'
    config_profile_url = 'NA'
    config_profile_name = 'CuAIM'

    max_cpus = 4
    max_memory = "100 GB"
    max_time = 1.d
}

singularity {
    enabled = true
    autoMounts = true
}

executor {
    name = 'slurm'
    jobName = { "${task.process.split(':').last()}" }
    queueSize = 10
    submitRateLimit = "10 sec"
}

process {
    resourceLimits = [memory: "100 G", cpus: 4, time: 1.d]
    clusterOptions = "--qos=cpu24h"
    cache = 'lenient'
}
